# Copier ce fichier en .env pour le developpement local.
# Ces deux variables sont obligatoires : l'application refuse de demarrer sans SECRET_KEY.

# URL de connexion Postgres (Neon) : Dashboard Neon > Connection string
DATABASE_URL=postgresql://utilisateur:motdepasse@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Cle de signature des cookies de session. A generer avec :
#   python -c "import secrets; print(secrets.token_hex(32))"
# Ne jamais la commiter ni la reutiliser d'un environnement a l'autre.
SECRET_KEY=a-generer
